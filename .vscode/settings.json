{
  "angular.enable-strict-mode-prompt": false,
  "js/ts.suggest.autoImports": true,
  "editor.formatOnSave": true,
  "editor.quickSuggestions": {
    "other": true,
    "strings": "on",
    "comments": false
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.classFunctions": ["tw", "clsx", "classes", "hlm", "tw\\.[a-z-]+"]
}
